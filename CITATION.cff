    given-names: Soheil
repository-code: https://github.com/soheil-mp/pecten
url: https://github.com/soheil-mp/pecten
license: MIT
version: 0.0.0
keywords:
  - bird monitoring
  - thermal imaging
  - camera traps
  - drones
  - data engineering
  - computer vision
