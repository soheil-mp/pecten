# Copy to .env and fill in values for your machine. Never commit .env.
# Every variable the code reads must be listed here with a placeholder value.
# The roadmap milestone that introduces each group is named in brackets.

# --- Object storage (S3-compatible; local SeaweedFS by default) [M1] ---
PECTEN_S3_ENDPOINT=http://localhost:8333
PECTEN_S3_REGION=us-east-1
PECTEN_S3_BUCKET=pecten-lake
PECTEN_S3_ACCESS_KEY_ID=your-access-key-id
PECTEN_S3_SECRET_ACCESS_KEY=your-secret-access-key

# --- Iceberg REST catalog (Lakekeeper) and its PostgreSQL database [M1] ---
PECTEN_CATALOG_URI=http://localhost:8181/catalog
PECTEN_CATALOG_WAREHOUSE=pecten
PECTEN_CATALOG_DB_DSN=postgresql://lakekeeper:change-me@localhost:5432/lakekeeper

# --- Edge messaging (MQTT 5, Eclipse Mosquitto) [M1, mTLS from M9] ---
PECTEN_MQTT_URL=mqtts://localhost:8883
PECTEN_MQTT_CA_FILE=./secrets/pki/root_ca.crt
PECTEN_MQTT_CLIENT_CERT_FILE=./secrets/pki/device.crt
PECTEN_MQTT_CLIENT_KEY_FILE=./secrets/pki/device.key

# --- Platform backbone (Apache Kafka) and schema registry (Apicurio) [M1] ---
PECTEN_KAFKA_BOOTSTRAP=localhost:9092
PECTEN_SCHEMA_REGISTRY_URL=http://localhost:8080/apis/ccompat/v7

# --- Stream processing (RisingWave, PostgreSQL wire protocol) [M1] ---
PECTEN_RISINGWAVE_DSN=postgresql://root@localhost:4566/dev

# --- Query engine (Trino) [M1] ---
PECTEN_TRINO_URL=http://localhost:8088
PECTEN_TRINO_CATALOG=lake

# --- Orchestration (Apache Airflow 3) [M1] ---
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg://airflow:change-me@localhost:5432/airflow
AIRFLOW__API_AUTH__JWT_SECRET=replace-with-a-long-random-string

# --- Site and scenario selection [M3] ---
PECTEN_SITE_ID=demo-dunes
PECTEN_SCENARIO=scenarios/night-migration-dunes.yaml

# --- External public data sources (no keys required) [M11] ---
PECTEN_OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
PECTEN_OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
PECTEN_GBIF_API_URL=https://api.gbif.org/v1
PECTEN_PDOK_NATURA2000_URL=https://api.pdok.nl/rvo/natura2000/ogc/v1
PECTEN_CAMTRAP_DP_ARCHIVE_URL=https://ipt.nlbif.nl/archive.do?r=awd_pilot1

# --- Observability (OpenTelemetry) [M20] ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=pecten
